# RangeX C++17 Crow Backend Proxy Target (used by Vite dev server)
VITE_RANGEX_BACKEND_TARGET=http://127.0.0.1:8080

# REST API Base URL (defaults to /api when proxied through Vite)
VITE_RANGEX_API_BASE_URL=/api

# Realtime Event Stream URL (WebSocket endpoint on C++ Crow backend)
VITE_RANGEX_EVENTS_URL=/ws

# Event transport protocol: auto | sse | ws
VITE_RANGEX_EVENT_TRANSPORT=ws
