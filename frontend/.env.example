# Member 2 C++ Backend Proxy Target (used by Vite dev server)
VITE_RANGEX_BACKEND_TARGET=http://127.0.0.1:8080

# REST API Base URL (defaults to /api when proxied through Vite)
VITE_RANGEX_API_BASE_URL=/api

# Realtime Event Stream URL (supports ws://, wss://, or SSE /api/events)
VITE_RANGEX_EVENTS_URL=/api/events

# Event transport protocol: auto | sse | ws
VITE_RANGEX_EVENT_TRANSPORT=auto
